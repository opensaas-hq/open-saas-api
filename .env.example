# Application Environment (development, production, test)
NODE_ENV="development"

# Server Port for the API app
PORT="3000"

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_database"

# Better Auth Configuration
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET="super_secret_at_least_32_characters_long_random_string_here"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Comma-separated list of custom disposable/temporary email domains to block
# DISPOSABLE_EMAIL_DOMAINS=custom-burner.com,temp-mail.org
