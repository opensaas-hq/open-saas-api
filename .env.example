# Application Environment (development, production, test)
NODE_ENV="development"

# Server Port for the API app
PORT="3000"

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_database"

# Dedicated database for integration tests. Under `.env.test`, DATABASE_URL is
# set to this same URL so tests can never touch development data (§2.7).
DATABASE_URL_TEST="postgresql://postgres:your_password@localhost:5432/your_database_test"

# Connection pool settings (consumed by @opensaas/database). Safe defaults shown.
DB_POOL_MAX="10"              # Maximum pooled connections
DB_IDLE_TIMEOUT_S="20"        # Seconds before an idle connection is closed
DB_STATEMENT_TIMEOUT_MS="30000"  # Per-statement timeout, milliseconds
DB_CONNECT_TIMEOUT_S="10"     # Seconds to wait for the initial connection

# Connection resilience (§2.5). Retries apply to idempotent operations only.
DB_RETRY_MAX_ATTEMPTS="5"     # Total attempts, including the first
DB_RETRY_BASE_DELAY_MS="100"  # Base delay for jittered exponential backoff
DB_RETRY_MAX_DELAY_MS="5000"  # Upper bound for a single backoff delay
DB_BREAKER_ENABLED="true"     # Fail fast while the database is down
DB_BREAKER_FAILURE_THRESHOLD="5"  # Consecutive failures before opening
DB_BREAKER_COOLDOWN_MS="10000"    # Time open before a half-open probe
DB_BREAKER_PROBE_TIMEOUT_MS="2000"  # Budget for the half-open recovery probe

# Postgres Row-Level Security (second line of defense; §2.5). When "true", the
# client connects as the dedicated opensaas_app role and every tenant-scoped
# transaction sets the app.current_org GUC, so the database itself refuses
# cross-tenant reads/writes even for a buggy query. Off in local development
# until application-layer adoption is complete; on in the RLS test job.
RLS_ENABLED="false"

# Better Auth Configuration
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET="super_secret_at_least_32_characters_long_random_string_here"
BETTER_AUTH_URL="http://localhost:3000"

# Registration mode: public | waiting_list | invite_code | paid_required (default: public)
REGISTRATION_MODE="public"

# Optional: Comma-separated list of custom disposable/temporary email domains to block
# DISPOSABLE_EMAIL_DOMAINS=custom-burner.com,temp-mail.org

# Auth hardening (§3.4)
# Extra browser origins trusted for cookie-based auth requests (CSRF/origin
# check). BETTER_AUTH_URL is always trusted; the same list feeds API CORS (§4.5).
# TRUSTED_ORIGINS="https://app.example.com,https://admin.example.com"
# Built-in rate limiter for auth routes. Enabled by default.
AUTH_RATE_LIMIT_ENABLED="true"
AUTH_RATE_LIMIT_WINDOW_S="60"   # Window length in seconds
AUTH_RATE_LIMIT_MAX="100"       # Max requests per window per route-class
# Session lifetime policy (seconds).
SESSION_EXPIRES_IN_S="604800"   # Absolute session lifetime (7 days)
SESSION_UPDATE_AGE_S="86400"    # Refresh expiry at most once per day of activity

# Membership cache (§4.3). The tenant middleware caches the role of a user in
# the active organization for this many seconds, so a role change can stay
# invisible for at most this long. 0 disables caching (every request re-reads
# the `member` table).
MEMBERSHIP_CACHE_TTL_S="30"

# Request body size limit (§4.5), in bytes. A body above this size is refused
# with a 413 before it reaches a route.
BODY_SIZE_LIMIT_BYTES="1048576"  # 1 MiB

# Maximum number of contacts accepted in one bulk import (§4.5). A batch above
# this size is refused as a validation failure (422).
BULK_MAX_CONTACTS="1000"

# Write-endpoint rate limiter (§4.5). Better Auth guards its own routes; this
# one guards the project write endpoints (registration and the CRM writes).
WRITE_RATE_LIMIT_ENABLED="true"
WRITE_RATE_LIMIT_WINDOW_S="60"   # Window length in seconds
WRITE_RATE_LIMIT_MAX="30"        # Max write requests per window per client
