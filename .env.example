# Application Environment (development, production, test)
NODE_ENV="development"

# Server Port for the API app
PORT="3000"

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_database"

# Dedicated database for integration tests. Must differ from DATABASE_URL so
# tests can never touch development data (§2.7). Optional outside test tooling.
DATABASE_URL_TEST="postgresql://postgres:your_password@localhost:5432/your_database_test"

# Connection pool settings (consumed by @opensaas/database). Safe defaults shown.
DB_POOL_MAX="10"              # Maximum pooled connections
DB_IDLE_TIMEOUT_S="20"        # Seconds before an idle connection is closed
DB_STATEMENT_TIMEOUT_MS="30000"  # Per-statement timeout, milliseconds
DB_CONNECT_TIMEOUT_S="10"     # Seconds to wait for the initial connection

# Connection resilience (§2.5). Retries apply to idempotent operations only.
DB_RETRY_MAX_ATTEMPTS="5"     # Total attempts, including the first
DB_RETRY_BASE_DELAY_MS="100"  # Base delay for jittered exponential backoff
DB_RETRY_MAX_DELAY_MS="5000"  # Upper bound for a single backoff delay
DB_BREAKER_ENABLED="true"     # Fail fast while the database is down
DB_BREAKER_FAILURE_THRESHOLD="5"  # Consecutive failures before opening
DB_BREAKER_COOLDOWN_MS="10000"    # Time open before a half-open probe

# Better Auth Configuration
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET="super_secret_at_least_32_characters_long_random_string_here"
BETTER_AUTH_URL="http://localhost:3000"

# Registration mode: public | waiting_list | invite_code | paid_required (default: public)
REGISTRATION_MODE="public"

# Optional: Comma-separated list of custom disposable/temporary email domains to block
# DISPOSABLE_EMAIL_DOMAINS=custom-burner.com,temp-mail.org
