# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (development, production, test)
NODE_ENV="development"

# Server Port for the API app
PORT="3000"

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
# Connection string for Supabase or any standard PostgreSQL instance.
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/your_database"

# ==============================================================================
# Authentication (Better Auth)
# ==============================================================================
# Secret key used to sign session tokens and cookies.
# Generate a secure random string (e.g., using `openssl rand -base64 32`)
BETTER_AUTH_SECRET="your_super_secret_better_auth_key_here"

# Base URL of your API (used for callback redirects and cookies)
BETTER_AUTH_URL="http://localhost:3000"
