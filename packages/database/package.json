{
  "name": "@opensaas/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:push:test": "bun --env-file=../../.env.test drizzle-kit push",
    "db:rls:test": "bun --env-file=../../.env.test scripts/apply-rls.ts setup",
    "db:rls:test:down": "bun --env-file=../../.env.test scripts/apply-rls.ts teardown",
    "db:rls:dev": "bun --env-file=../../.env scripts/apply-rls.ts setup",
    "db:rls:dev:down": "bun --env-file=../../.env scripts/apply-rls.ts teardown",
    "test:unit": "bun test src/__tests__/like.test.ts src/__tests__/resilience.test.ts",
    "test:integration": "bun --env-file=../../.env.test test src/__tests__",
    "test": "bun --env-file=../../.env.test test src/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opensaas/core": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0"
  }
}
