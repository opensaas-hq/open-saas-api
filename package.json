{
  "name": "open-saas-api",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @opensaas/api dev",
    "build": "bun run --filter \"*\" build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test --root .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky",
    "release": "release-it"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/bun": "latest",
    "bun-types": "^1.4.3",
    "husky": "^9.1.7",
    "release-it": "^21.1.1",
    "typescript": "^5.7.0"
  }
}
