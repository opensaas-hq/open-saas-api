{
  "name": "open-saas-api-monorepo",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @opensaas/api dev",
    "build": "bun run --filter \"*\" build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test --root .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "latest",
    "bun-types": "^1.4.3",
    "husky": "^9.1.7",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
