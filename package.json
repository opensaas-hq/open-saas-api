{
  "name": "open-saas-api",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @opensaas/api dev",
    "demo": "bun run docs/examples/demo.ts",
    "build": "bun run --filter \"*\" build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "test:unit": "bun test --test-name-pattern=\"unit|config|errors|logger|response|like|resilience\" 2>&1 || bun test packages/core/src/__tests__ packages/database/src/__tests__/like.test.ts packages/database/src/__tests__/resilience.test.ts",
    "test:integration": "bun test apps packages --ignore='**/*.unit.*'",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky",
    "release": "release-it"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/bun": "^1.2.0",
    "husky": "^9.1.7",
    "release-it": "^21.1.1",
    "typescript": "^5.7.0"
  }
}
