{
  "name": "open-saas-api-monorepo",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter @opensaas/api dev",
    "build": "bun run --filter \"*\" build",
    "test": "bun test --root .",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
